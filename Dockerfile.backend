# syntax=docker/dockerfile:1

# Global build arg — must be declared before the first FROM so it can be used to
# select the model-bundle stage in a later `FROM models-${BUNDLE_MODELS}`.
ARG BUNDLE_MODELS=false

# ─── Stage 1: dependency builder ──────────────────────────────────────────────
FROM python:3.11-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git \
        libgl1 libglib2.0-0 libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# Install PyTorch (+ torchvision, required by ultralytics/YOLO) separately so we
# can swap CPU/CUDA index via build arg. Default: CPU-only; the GPU compose
# overrides TORCH_INDEX_URL with a CUDA index (e.g. cu126).
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir torch torchvision --index-url "${TORCH_INDEX_URL}"

# Install all runtime Python deps from backend/requirements.txt.
# This covers both the FastAPI server and the Marker OCR library deps.
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install the marker package (project root) without re-installing deps.
COPY pyproject.toml ./
COPY README.md ./
COPY marker/ ./marker/
RUN pip install --no-cache-dir --no-deps .

# surya.ocr_error uses transformers.onnx which was removed long ago — stub it out
RUN python - <<'EOF'
import os, surya
init_path = os.path.join(os.path.dirname(surya.__file__), "ocr_error/__init__.py")
open(init_path, "w").write("""
class _Results:
    def __init__(self, n):
        self.labels = ["good"] * n

class OCRErrorPredictor:
    def __init__(self, *args, **kwargs):
        self.disable_tqdm = False
    def __call__(self, page_texts, batch_size=None):
        return _Results(len(page_texts))
""")
print("Stubbed surya/ocr_error/__init__.py")
EOF

# ─── Optional model bundle ────────────────────────────────────────────────────
# BUNDLE_MODELS=true bakes the pre-downloaded Surya/Datalab model weights and the
# Marker font into the image for fully offline operation (no model downloads at
# the deployment site). Requires ./_bundle to exist (staged from the local cache).
# BUNDLE_MODELS=false (default) keeps the image lean; models download on first run.
FROM alpine:3.20 AS models-true
WORKDIR /bundle
COPY _bundle/ ./

FROM alpine:3.20 AS models-false
WORKDIR /bundle
RUN mkdir -p datalab/models fonts

# BUNDLE_MODELS is the global ARG declared at the top of this file.
FROM models-${BUNDLE_MODELS} AS model-stage

# ─── Stage 2: lean runtime image ──────────────────────────────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# Runtime shared libraries + a C toolchain. On GPU, Torch/Triton JIT-compiles
# CUDA kernel launchers and needs a C compiler AND the libc dev headers
# (gcc alone hits "fatal error: stdlib.h: No such file or directory").
# libc6-dev provides the standard C headers. Harmless (unused) on CPU-only hosts.
RUN apt-get update && apt-get install -y --no-install-recommends \
        libgl1 libglib2.0-0 libsm6 libxext6 \
        gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root user for security
RUN groupadd -r app && useradd -r -g app -u 1000 -m -d /home/app app

# Copy the full Python package tree from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages \
                    /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application source
COPY backend/ ./backend/

# YOLO Notes model (small; always present in build context)
COPY --chown=app:app models/ ./models/

# Bundled (or empty) Surya/Datalab model weights + Marker font.
# --chown at copy time avoids a costly recursive chown layer for the ~3 GB tree.
COPY --chown=app:app --from=model-stage /bundle/datalab/models /models/datalab
COPY --chown=app:app --from=model-stage /bundle/fonts          /models/fonts

# Pre-create writable dirs; chown only the small trees (models are already owned
# via --chown above, so we must NOT recursively chown the multi-GB /models tree).
RUN mkdir -p \
        /app/backend/uploads \
        /home/app/.cache/datalab \
        /models/torch \
    && chown -R app:app /app /home/app \
    && chown app:app /models /models/torch

# Model caches & paths. MODEL_CACHE_DIR points Surya at the baked weights;
# YOLO_MODEL_PATH / FONT_* point at the bundled files. Offline flags are set by
# the deployment compose (docker-compose.company.yml), not here, so the lean
# build can still download on first run.
ENV HF_HOME=/models \
    TORCH_HOME=/models/torch \
    MODEL_CACHE_DIR=/models/datalab \
    FONT_DIR=/models/fonts \
    FONT_PATH=/models/fonts/GoNotoCurrent-Regular.ttf \
    YOLO_MODEL_PATH=/app/models/notes_best.pt \
    HOST=0.0.0.0 \
    PORT=8001

USER app
WORKDIR /app/backend

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD python -c \
        "import urllib.request; urllib.request.urlopen('http://localhost:8001/api/health')" \
    || exit 1

CMD ["python", "main.py"]
