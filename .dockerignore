# ── Git & IDE ─────────────────────────────────────────────────────────────────
.git/
.gitignore
.vscode/
.claude/
.ruff_cache/

# ── Python cache / build artifacts ────────────────────────────────────────────
**/__pycache__/
**/*.py[cod]
*.egg-info/
dist/
.venv/

# ── Node / frontend build artifacts ───────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ── Stale hand-staged deploy copy ─────────────────────────────────────────────
# An older snapshot of the backend (pre-UUID-upload-paths, no fastdoc/YOLO).
# Keeping it out of the build context makes it impossible to ship by accident.
deploy/

# ── Secrets (never bake into images) ──────────────────────────────────────────
.env
.env.*
!.env.example
backend/.env
frontend/.env

# ── Large runtime data (not needed in image) ──────────────────────────────────
Anacondaenvspdf_ocr_opdata/
backend/uploads/
backend/erp_jobs/
# Learned customer profiles — one file per customer, created at runtime.
# Customer data, and the deployment's own state: keep it out of the image
# and out of git. Mount it as a volume beside erp_jobs.
backend/erp/profiles/
mcp_server/.env
data/
static/

# ── Sample / test files ───────────────────────────────────────────────────────
*.pdf

# ── Docs (not needed at runtime) ──────────────────────────────────────────────
*.md
!README.md
LICENSE
MODEL_LICENSE
