# ── Where this MCP server reaches the 規格析 backend (internal) ──────────────
SPECOCR_BASE_URL=http://localhost:8000

# Base URL written into the returned download links — what the host's frontend
# and end users can actually reach. Leave blank to reuse SPECOCR_BASE_URL.
# 知識通 is a cloud platform, so localhost links are dead links for everyone
# but you: put the backend's public/tunnel URL here.
SPECOCR_PUBLIC_BASE_URL=

# ── Auth to the backend ─────────────────────────────────────────────────────
# Must match the backend's API_KEY when that is set. Sent as X-API-Key.
# CAUTION: the backend enforces the key on ALL /api/* routes including
# /api/erp/*/export.xlsx, so setting it also makes the download links require
# the header — i.e. unclickable in a browser. If end users need to click the
# links, put access control at a reverse proxy instead and leave API_KEY unset.
SPECOCR_API_KEY=

# ── This server's own bind address (streamable-HTTP) ────────────────────────
SPECOCR_MCP_HOST=127.0.0.1
SPECOCR_MCP_PORT=8766
SPECOCR_TIMEOUT=60

# ── Reaching this server through a tunnel / reverse proxy ───────────────────
# FastMCP's DNS-rebinding protection only trusts localhost Host headers, so a
# request arriving under a public hostname is rejected with HTTP 421. Pin the
# hostname(s) you actually serve under:
# SPECOCR_MCP_ALLOWED_HOSTS=your-tunnel.trycloudflare.com
# SPECOCR_MCP_ALLOWED_ORIGINS=https://your-tunnel.trycloudflare.com
# ...or disable the check entirely (only behind a proxy that does access control):
# SPECOCR_MCP_PUBLIC=1

# NOTE: there is NO LLM in this stack. 知識通 is the brain; the backend only
# stores markdown and writes xlsx. There is nothing to configure for
# providers/keys here.
