# syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# All-in-one image: React frontend (nginx) + FastAPI backend (uvicorn) in ONE
# container, orchestrated by supervisord. Mirrors the GPU + model-bundled setup
# of Dockerfile.backend, but collapses the two services into a single image.
#
# Build (GPU + baked models, needs ./_bundle):
#   docker build -f Dockerfile.allinone \
#     --build-arg TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126 \
#     --build-arg BUNDLE_MODELS=true \
#     -t printlens:allinone .
# Run:
#   docker run --gpus all -p 8080:80 printlens:allinone
# Open:  http://<host>:8080
# ─────────────────────────────────────────────────────────────────────────────

# Global build arg — declared before the first FROM so it can select the
# model-bundle stage in a later `FROM models-${BUNDLE_MODELS}`.
ARG BUNDLE_MODELS=false

# ── Stage 1: Node — build frontend ──────────────────────────────────────────
FROM node:20-alpine AS frontend-builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --frozen-lockfile

COPY frontend/ ./

# Relative URL: nginx proxies /api/* to uvicorn internally
ARG VITE_API_BASE_URL=/
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ── Stage 2: Python — install deps ──────────────────────────────────────────
FROM python:3.11-slim AS python-builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential git \
        libgl1 libglib2.0-0 libsm6 libxext6 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --upgrade pip

# Install PyTorch (+ torchvision, required by ultralytics/YOLO) separately so we
# can swap CPU/CUDA index via build arg. Default: CPU-only; the GPU build
# overrides TORCH_INDEX_URL with a CUDA index (e.g. cu126).
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir torch torchvision --index-url "${TORCH_INDEX_URL}"

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY pyproject.toml ./
COPY README.md ./
COPY marker/ ./marker/
RUN pip install --no-cache-dir --no-deps .

# requirements.txt is mostly `>=`, so two builds a month apart can resolve to
# different versions of packages that parse untrusted input (openpyxl,
# python-docx, Pillow, ultralytics). Record what this image actually resolved
# to, so a build can be reproduced and a CVE can be checked against a real
# version list rather than a range. Extract with:
#   docker run --rm printlens:allinone cat /app/requirements.lock.txt
RUN pip freeze > /requirements.lock.txt

# surya.ocr_error uses transformers.onnx which was removed long ago — stub it out
RUN python - <<'EOF'
import os, surya
init_path = os.path.join(os.path.dirname(surya.__file__), "ocr_error/__init__.py")
open(init_path, "w").write("""
class _Results:
    def __init__(self, n):
        self.labels = ["good"] * n

class OCRErrorPredictor:
    def __init__(self, *args, **kwargs):
        self.disable_tqdm = False
    def __call__(self, page_texts, batch_size=None):
        return _Results(len(page_texts))
""")
print("Stubbed surya/ocr_error/__init__.py")
EOF

# ── Optional model bundle ───────────────────────────────────────────────────
# BUNDLE_MODELS=true bakes the pre-downloaded Surya/Datalab model weights and
# the Marker font into the image for fully offline operation. Requires ./_bundle
# to exist (staged from the local cache). false (default) keeps the image lean.
FROM alpine:3.20 AS models-true
WORKDIR /bundle
COPY _bundle/ ./

FROM alpine:3.20 AS models-false
WORKDIR /bundle
RUN mkdir -p datalab/models fonts

# BUNDLE_MODELS is the global ARG declared at the top of this file.
FROM models-${BUNDLE_MODELS} AS model-stage

# ── Stage 3: Runtime — nginx + uvicorn via supervisor ───────────────────────
FROM python:3.11-slim AS runtime

WORKDIR /app

# nginx + supervisor + runtime shared libs + a C toolchain. On GPU, Torch/Triton
# JIT-compiles CUDA kernel launchers and needs a C compiler AND the libc dev
# headers (gcc alone hits "fatal error: stdlib.h: No such file or directory").
RUN apt-get update && apt-get install -y --no-install-recommends \
        nginx supervisor \
        libgl1 libglib2.0-0 libsm6 libxext6 \
        gcc libc6-dev \
    && rm -rf /var/lib/apt/lists/*

# Non-root runtime user, matching Dockerfile.backend's `USER app`. Created
# before the first --chown COPY, which needs the account to already exist.
#
# supervisord itself stays root — it needs that to bind nginx to :80 and to
# drop privileges for its children. Both children then run unprivileged:
# nginx spawns its workers as `www-data` (its own default), and the Python
# backend runs as `app` via `user=app` in supervisord.conf. So no application
# code — Marker, Surya, YOLO, FastAPI — executes as root, which is what the
# RCE blast-radius argument is actually about.
RUN groupadd -r app && useradd -r -g app -d /home/app -s /sbin/nologin app

# Python packages from builder
COPY --from=python-builder /usr/local/lib/python3.11/site-packages \
                            /usr/local/lib/python3.11/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin

# Backend source. Always from the repo-root backend/ — never deploy/, which
# is an older snapshot without the UUID upload paths, fastdoc, or YOLO.
# .dockerignore excludes deploy/ so that mistake cannot be made silently.
COPY backend/ ./backend/

# Resolved dependency versions for this image (see the pip freeze above).
COPY --from=python-builder /requirements.lock.txt /app/requirements.lock.txt

# YOLO Notes model (small; always present in build context)
COPY models/ ./models/

# Bundled (or empty) Surya/Datalab model weights + Marker font.
# --chown here rather than a later `chown -R`: these are ~3.3 GB, and chowning
# them in a separate RUN would copy every byte into a second image layer.
COPY --chown=app:app --from=model-stage /bundle/datalab/models /models/datalab
COPY --chown=app:app --from=model-stage /bundle/fonts          /models/fonts

# Frontend built assets
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# Configs
COPY nginx.allinone.conf /etc/nginx/conf.d/default.conf
COPY supervisord.conf     /etc/supervisor/conf.d/app.conf

# Remove default nginx site
RUN rm -f /etc/nginx/sites-enabled/default

# Writable dirs
RUN mkdir -p \
        /app/backend/uploads \
        /home/app/.cache/datalab \
        /models/torch \
        /tmp/Ultralytics \
        /var/log/supervisor \
    && chown -R app:app /app/backend/uploads /home/app /tmp/Ultralytics /models/torch

# Model caches & paths. MODEL_CACHE_DIR points Surya at the baked weights;
# YOLO_MODEL_PATH / FONT_* point at the bundled files.
ENV HF_HOME=/models \
    TORCH_HOME=/models/torch \
    MODEL_CACHE_DIR=/models/datalab \
    FONT_DIR=/models/fonts \
    FONT_PATH=/models/fonts/GoNotoCurrent-Regular.ttf \
    YOLO_MODEL_PATH=/app/models/notes_best.pt \
    YOLO_CONFIG_DIR=/tmp/Ultralytics \
    MAX_BATCH_FILES=50 \
    HOST=0.0.0.0 \
    PORT=8001

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=180s --retries=5 \
    CMD python -c \
        "import urllib.request; urllib.request.urlopen('http://localhost:8001/api/health')" \
    || exit 1

CMD ["/usr/bin/supervisord", "-n", "-c", "/etc/supervisor/conf.d/app.conf"]
