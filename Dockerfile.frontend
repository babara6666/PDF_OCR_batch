# syntax=docker/dockerfile:1
# ─── Stage 1: Node build ──────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Install deps with deterministic lockfile
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --frozen-lockfile

# Copy source and build
COPY frontend/ ./

# In production Docker, the nginx reverse proxy routes /api/* to the backend,
# so the baseURL is same-origin instead of a hardcoded host.
# Do NOT write `/` here: Git Bash/MSYS rewrites a lone `/` build-arg to
# `C:/Program Files/Git/`, which axios bakes in as baseURL and the browser then
# reports "Unsupported protocol C:". `same-origin` is stripped to "" in
# frontend/src/services/api.js.
ARG VITE_API_BASE_URL=same-origin
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN npm run build

# ─── Stage 2: nginx static server ─────────────────────────────────────────────
FROM nginx:1.27-alpine AS runtime

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/index.html || exit 1

CMD ["nginx", "-g", "daemon off;"]
