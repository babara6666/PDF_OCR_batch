# ── 對外 Port ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8090

# ── Backend 設定 ──────────────────────────────────────────────────────────────
# CORS 允許的來源（逗號分隔，依部署環境修改）
CORS_ORIGINS=,http://localhost:8090,http://127.0.0.1

# ── 快速路徑 fastdoc（選填）──────────────────────────────────────────────────
# 設為 1 後，/api/upload 與 /api/upload-batch 會先檢查 PDF 是否自帶文字層。
# 有文字層的電子檔直接用毫秒級抽取，掃描件才進 Marker OCR。掃描件行為不變。
# FASTDOC_ROUTING=1

# ── AI API 金鑰（選填，若使用 LLM 功能才需要）────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
