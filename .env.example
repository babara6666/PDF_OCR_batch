# ── 對外 Port ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8090

# ── Backend 設定 ──────────────────────────────────────────────────────────────
# CORS 允許的來源（逗號分隔，依部署環境修改）
# 前 3 個是 Docker 對外 port，後面 4 個是本機開發用的 vite dev server
# （vite.config.js 預設 5174，README 的流程寫 5173，兩個都留著）。
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── 存取控制 ──────────────────────────────────────────────────────────────────
# 設了 API_KEY 之後，所有 /api/* 都必須帶 X-API-Key 這個 header
# （/api/health 例外，否則容器健康檢查會失敗）。留空 = 不驗證，維持現狀。
# 對外或跨部門開放前建議一定要設，並搭配 VPN / 防火牆白名單。
# API_KEY=

# 每個 IP 在 RATE_LIMIT_WINDOW 秒內最多幾個請求（設 0 關閉）。
# 預設很寬鬆——批次是「少量大請求」，這個上限擋的是有人腳本狂打 GPU。
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# 單一批次最多幾個檔案（0 = 無上限，不建議）
MAX_BATCH_FILES=50

# ZIP 類文件（docx/xlsx/pptx）解壓後的大小上限，預設 200MB。
# 擋的是壓縮炸彈：50MB 的上傳限制只管到網路上的位元組，管不到解開後的記憶體。
# MAX_UNCOMPRESSED_SIZE=209715200

# 同時能有幾份文件進 Marker OCR。Marker 佔著 GPU，預設 1（序列化）。
# MARKER_CONCURRENCY=1

# ── 快速路徑 fastdoc（選填）──────────────────────────────────────────────────
# 設為 1 後，/api/upload 與 /api/upload-batch 會先檢查 PDF 是否自帶文字層。
# 有文字層的電子檔直接用毫秒級抽取，掃描件才進 Marker OCR。掃描件行為不變。
# FASTDOC_ROUTING=1

# 雙軌輸出：有文字層的文件不再「用 fastdoc 取代 Marker」，而是兩種都跑、兩份都回。
# Marker 負責排版重建，fastdoc 給的是檔案裡原本就有的字元。需搭配 FASTDOC_ROUTING=1。
# 前端的「雙軌輸出」開關會覆寫這個預設值。
# FASTDOC_DUAL=1

# ── ERP 匯入模式（選填）──────────────────────────────────────────────────────
# 辨識好、等知識通來拿的報告暫存在哪裡。裡面是客戶的檢驗資料，
# 用 Docker 時記得掛成 volume，否則容器一重建就沒了。
# ERP_JOBS_DIR=/app/backend/erp_jobs

# 暫存多久之後自動清掉（天）。這些是客戶檢驗資料，不該無限期堆在硬碟上。
# ERP_JOBS_RETENTION_DAYS=14

# job 數量上限，超過從最舊的開始刪。只靠保留天數擋不住一天上傳 500 份的情況。
# ERP_JOBS_MAX=2000

# 整個暫存區的容量上限（MB），超過從最舊的開始刪。覆核畫面會留下原始 PDF 與
# 算好的頁面圖，一份掃描報告就好幾 MB，光算 job 數量已經擋不住硬碟被塞滿。
# ERP_JOBS_MAX_MB=4096

# 單一份原始 PDF 的大小上限（MB）。超過就不留原始檔，覆核時改看 Markdown。
# ERP_SOURCE_MAX_MB=20

# 客戶設定檔放哪裡（一個客戶一個 yaml，前端建立）。內建的 default 設定檔在
# backend/erp/schema.yaml，不在這個資料夾裡。這裡面是客戶的欄位定義與別名，
# 用 Docker 時跟 erp_jobs 一樣要掛成 volume，否則重建容器就沒了。
# ERP_PROFILES_DIR=/app/backend/erp/profiles

# 預設情況下後端「不需要」任何 LLM 金鑰：做欄位理解的是知識通（MCP host），
# 後端只負責存檔與匯出。MCP server 的設定在 mcp_server/.env.example。
#
# ── 連不到知識通時：讓後端自己叫模型（選填）─────────────────────────────────
# 留空＝維持原本行為（只有知識通經 MCP 能對應）。填了才會出現「對應引擎」選單。
# 依序嘗試，前面失敗就換下一個；全部失敗時 job 留在「等待中」，知識通仍可接手。
# 本機優先，工廠端連不到公司網路時才不會整批卡住。
# ERP_LLM_PROVIDERS=ollama,gateway

# 固定用某一個模型（通常留空，讓每個引擎用自己的預設，畫面上也可以現場選）。
# ERP_LLM_MODEL=

# 本機 Ollama。用 Docker 時 localhost 指的是「容器自己」，要連到宿主機上的
# Ollama 請填 http://host.docker.internal:11434。
# OLLAMA_BASE_URL=http://localhost:11434

# Ollama 預設 num_ctx 只有 4096，雙軌輸出的報告一定會被截掉而且不會報錯。
# ERP_OLLAMA_NUM_CTX=32768

# 公司自架的 OpenAI 相容 gateway（LiteLLM）。模型清單在執行時跟 proxy 要。
# GATEWAY_BASE_URL=http://llmgateway.fst:4000/v1
# GATEWAY_API_KEY=

# 單份報告的等待上限（秒）。本機模型讀一份掃描件是以分鐘計的。
# ERP_LLM_TIMEOUT=900

# ── AI API 金鑰（選填，若使用 LLM 功能才需要）────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
