# ── 對外 Port ────────────────────────────────────────────────────────────────
FRONTEND_PORT=8090

# ── Backend 設定 ──────────────────────────────────────────────────────────────
# CORS 允許的來源（逗號分隔，依部署環境修改）
# 前 3 個是 Docker 對外 port，後面 4 個是本機開發用的 vite dev server
# （vite.config.js 預設 5174，README 的流程寫 5173，兩個都留著）。
CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ── 存取控制 ──────────────────────────────────────────────────────────────────
# 設了 API_KEY 之後，所有 /api/* 都必須帶 X-API-Key 這個 header
# （/api/health 例外，否則容器健康檢查會失敗）。留空 = 不驗證，維持現狀。
# 對外或跨部門開放前建議一定要設，並搭配 VPN / 防火牆白名單。
# API_KEY=

# 每個 IP 在 RATE_LIMIT_WINDOW 秒內最多幾個請求（設 0 關閉）。
# 預設很寬鬆——批次是「少量大請求」，這個上限擋的是有人腳本狂打 GPU。
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60

# 單一批次最多幾個檔案（0 = 無上限，不建議）
MAX_BATCH_FILES=50

# ZIP 類文件（docx/xlsx/pptx）解壓後的大小上限，預設 200MB。
# 擋的是壓縮炸彈：50MB 的上傳限制只管到網路上的位元組，管不到解開後的記憶體。
# MAX_UNCOMPRESSED_SIZE=209715200

# 同時能有幾份文件進 Marker OCR。Marker 佔著 GPU，預設 1（序列化）。
# MARKER_CONCURRENCY=1

# ── 快速路徑 fastdoc（選填）──────────────────────────────────────────────────
# 設為 1 後，/api/upload 與 /api/upload-batch 會先檢查 PDF 是否自帶文字層。
# 有文字層的電子檔直接用毫秒級抽取，掃描件才進 Marker OCR。掃描件行為不變。
# FASTDOC_ROUTING=1

# 雙軌輸出：有文字層的文件不再「用 fastdoc 取代 Marker」，而是兩種都跑、兩份都回。
# Marker 負責排版重建，fastdoc 給的是檔案裡原本就有的字元。需搭配 FASTDOC_ROUTING=1。
# 前端的「雙軌輸出」開關會覆寫這個預設值。
# FASTDOC_DUAL=1

# ── AI API 金鑰（選填，若使用 LLM 功能才需要）────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
